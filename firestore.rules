rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public visitors submit only through callable Cloud Functions (Admin SDK).
    // No direct client reads or writes are permitted for these private collections.
    match /contactInquiries/{document=**} { allow read, write: if false; }
    match /newsletterSubscribers/{document=**} { allow read, write: if false; }
    match /_rateLimits/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
